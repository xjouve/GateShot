    <string name="onboarding_page_indicator">Page %1$d of %2$d</string>
    <string name="onboarding_page1_title">Welcome to GateShot</string>
    <string name="onboarding_page1_desc">Ski racing video analysis for coaches and athletes.\n\nFilm your runs with your phone\'s camera app — its stabilization is unbeatable — then bring the footage here to break it down.</string>
    <string name="onboarding_page2_title">Film with the Camera App</string>
    <string name="onboarding_page2_desc">Record runs in your phone\'s native camera app as usual — zoom, teleconverter, stabilization all work at their best there.\n\nThen import the clips into GateShot\'s Library.</string>
    <string name="onboarding_page2_tip">Or share a video straight from your gallery to GateShot</string>
    <string name="onboarding_page3_title">Replay &amp; Compare</string>
    <string name="onboarding_page3_desc">Slow motion, frame stepping, and run-over-run comparison: ghost overlay, wipe, and split-screen — synchronized gate by gate.</string>
    <string name="onboarding_page3_tip">Mark gates while reviewing to unlock timing analysis</string>
    <string name="onboarding_page4_title">Coach Tools</string>
    <string name="onboarding_page4_desc">Draw on frames, record voice-over feedback, track athletes across sessions, and generate session reports.\n\nGlove-friendly controls, built for the slope.</string>
    <string name="onboarding_page5_title">Ready to Analyze</string>
    <string name="onboarding_page5_desc">Start a session, import today\'s runs, and dive in.\n\nGood luck out there! 🏁</string>

