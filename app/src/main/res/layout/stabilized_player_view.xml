<?xml version="1.0" encoding="utf-8"?>
<!-- TextureView-backed player for the main Replay video: graphicsLayer
     transforms (stabilization warp) and render effects (color correction)
     only reach the pixels through a TextureView; the default SurfaceView
     composites on a separate layer and ignores them (ticket 020). -->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:use_controller="false" />
